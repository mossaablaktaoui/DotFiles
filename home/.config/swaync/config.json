{
  "positionX": "center",
  "positionY": "top",
  "layer": "overlay",
  "cssPriority": "user",
  "control-center-width": 400,
  "control-center-positionX": "right",
  "control-center-positionY": "top",
  "notification-window-width": 400,
  "notification-icon-size": 50,
  "notification-body-image-height": 500,
  "notification-body-image-width": 500,
  "notification-inline-replies": true,
  "notification-2fa-action": false,
  "timeout": 7,
  "timeout-low": 4,
  "timeout-critical": 10,
  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 0,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "label#system-info",
    "buttons-grid",
    "backlight",
    "volume",
	"title#notifications-title",
    "mpris",
    "notifications"
  ],
  "widget-config": {
    "label#system-info": {
      "max-lines": 1,
      "text": "Notification Panel"
    },
    "buttons-grid": {
      "actions": [
        {
          "label": " ",
          "command": "$HOME/.config/control-center/run-wifi.sh"
        },
        {
          "label": "",
          "command": "$HOME/.config/control-center/run-bluetooth.sh"
        },
		{
			"label": "",
			"type": "toggle",
			"command": "$HOME/.config/swaync/scripts/mute_toggle.sh",
			"update-command": "$HOME/.config/swaync/scripts/mute_status.sh"
		},
        {
          "label": "󰀃",
          "command": "$HOME/.config/control-center/run-hotspot.sh"
        },
        {
          "label": "󰂞",
          "type": "toggle",
          "command": "$HOME/.config/swaync/scripts/dnd_toggle.sh",
          "update-command": "$HOME/.config/swaync/scripts/dnd_status.sh"
        },
        {
          "label": "󱣵",
          "command": "$HOME/.config/swaync/scripts/screenshot.sh"
        },
        {
          "label": "",
          "command": "$HOME/.config/rofi/scripts/clipboard-menu"
        },
        {
          "label": "󰍽",
          "type": "toggle",
          "command": "$HOME/.config/swaync/scripts/touchpad_toggle.sh",
          "update-command": "$HOME/.config/swaync/scripts/touchpad_status.sh"
        },
        {
          "label": "󰒓",
          "command": ""
        },
        {
          "label": "󰐥",
          "command": "$HOME/.config/rofi/scripts/power-menu"
        }
      ]
    },
    "backlight": {
      "label": "󰃠",
      "slider": true,
      "min": 10
    },
    "volume": {
      "label": "",
      "slider": true
    },
	"title#notifications-title": {
		"text": "Notifications",
		"clear-all-button": true,
		"button-text": "󰎟"
	},
    "mpris": {
      "image-size": 100,
      "image-radius": 10,
      "autohide": false,
      "blacklist": [
        "org.mpris.MediaPlayer2.playerctld"
      ]
    }
  }
}
