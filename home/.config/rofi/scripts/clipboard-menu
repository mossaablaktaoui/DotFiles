#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME="$CONFIG_HOME/rofi/clipboard.rasi"

# Close the SwayNC control center before opening Rofi.
swaync-client -cp 2>/dev/null || true

selection="$({
	cliphist list |
		rofi -dmenu \
			-i \
			-no-custom \
			-p "  Clipboard" \
			-display-columns 2 \
			-theme "$THEME"
} || true)"

[[ -n "$selection" ]] || exit 0

printf '%s\n' "$selection" |
	cliphist decode |
	wl-copy
