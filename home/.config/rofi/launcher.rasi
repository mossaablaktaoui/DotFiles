configuration {
    modi: "drun,window,filebrowser,run";
    font: "Lato Bold 11";
    show-icons: true;

    display-drun: "Apps";
    display-filebrowser: "Files";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";

    click-to-exit: true;
    close-on-delete: true;
    kb-cancel: "Escape";
    hover-select: true;
    scroll-method: 1;
}

@theme "~/.config/liquid-glass/palette.rasi"

window {
    width: 25em;
    transparency: "real";
    padding: 10px;

    background-color: @lg-glass;
    border: @lg-edge-border;
    border-color: @lg-border;
    border-radius: @lg-radius-large;
}

mainbox,
listview,
mode-switcher {
    background-color: transparent;
}

mainbox {
    spacing: @lg-gap-medium;
    children: [ inputbar, listview, mode-switcher ];
}

inputbar,
element,
button {
    background-color: @lg-surface;
    border: @lg-edge-border;
    border-color: @lg-border;
}

inputbar {
    spacing: @lg-gap-medium;
    padding: 8px 12px;
    border-radius: @lg-radius-pill;
    children: [ textbox-prompt-colon, entry ];
}

textbox-prompt-colon {
    expand: false;
    str: "";
    font: "AtkynsonMono Nerd Font Bold 11";
    padding: 0px 12px 0px 4px;

    text-color: @lg-text;
    background-color: transparent;
}

entry {
    placeholder: "Search";
    placeholder-color: @lg-dim;
    text-color: @lg-text;
    background-color: transparent;
}

listview {
    lines: 5;
    columns: 1;
    spacing: @lg-gap-small;
    padding: 2px;

    fixed-height: true;
    dynamic: true;
    cycle: true;
    scrollbar: false;
}

element {
    spacing: 12px;
    padding: 7px 9px;
    border-radius: @lg-radius-large;
    text-color: @lg-text;
}

element-icon {
    size: 28px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    text-color: @lg-text;
    background-color: transparent;
}

element selected,
button selected,
element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @lg-hover;
    text-color: @lg-text;
}

element normal.active,
element alternate.active,
element normal.urgent,
element alternate.urgent {
    text-color: @lg-text;
}

mode-switcher {
    spacing: @lg-gap-small;
}

button {
    margin: 1px 0px;
    padding: 9px 12px;
    border-radius: @lg-radius-large;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    text-color: @lg-text;
}

message {
    padding: 8px;
    border-radius: @lg-radius-medium;
    text-color: @lg-text;
    background-color: @lg-surface;
}

textbox {
    text-color: @lg-text;
    background-color: transparent;
}

error-message {
    padding: 10px;
    text-color: @lg-text;
    background-color: @lg-glass;
}
