    lg-glass: rgba(100, 100, 100, 0.08);
    lg-surface: rgba(255, 255, 255, 0.08);
    lg-surface-soft: rgba(255, 255, 255, 0.04);
    lg-hover: rgba(255, 255, 255, 0.18);
    lg-pressed: rgba(255, 255, 255, 0.30);
    lg-track: rgba(255, 255, 255, 0.14);
    lg-fill: rgba(255, 255, 255, 0.50);
    lg-border: rgba(255, 255, 255, 0.20);
    lg-border-strong: rgba(255, 255, 255, 0.40);
    lg-shine: rgba(255, 255, 255, 0.20);
    lg-shine-strong: rgba(255, 255, 255, 0.60);
    lg-text: #ffffff;
    lg-subtext: rgba(255, 255, 255, 0.82);
    lg-dim: rgba(255, 255, 255, 0.65);
    lg-solid: #ffffff;
    lg-on-solid: #000000;
    lg-solid-hover: rgba(0, 0, 0, 0.16);
    lg-disabled: #bbbbbb;
    lg-warning: #f9e2af;
    lg-critical: #f38ba8;
